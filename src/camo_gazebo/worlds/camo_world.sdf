<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="camo_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 60</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 60</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.25 0.35 0.15 1</ambient>
            <diffuse>0.3 0.45 0.18 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Simple procedural rock cluster: spheres, cheap on performance -->
    <model name="rock_cluster_1">
      <static>true</static>
      <pose>3 2 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><sphere><radius>0.35</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.35</radius></sphere></geometry>
          <material>
            <ambient>0.35 0.33 0.3 1</ambient>
            <diffuse>0.45 0.42 0.38 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rock_cluster_2">
      <static>true</static>
      <pose>3.6 1.6 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><sphere><radius>0.2</radius></sphere></geometry>
        </collision>
        <visual name="visual">
          <geometry><sphere><radius>0.2</radius></sphere></geometry>
          <material>
            <ambient>0.32 0.3 0.27 1</ambient>
            <diffuse>0.4 0.38 0.34 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Simple procedural tree: cylinder trunk + sphere canopy -->
    <model name="tree_1">
      <static>true</static>
      <pose>-3 3 0 0 0 0</pose>
      <link name="link">
        <visual name="trunk_visual">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.35 0.22 0.12 1</diffuse></material>
        </visual>
        <collision name="trunk_collision">
          <pose>0 0 0.75 0 0 0</pose>
          <geometry><cylinder><radius>0.12</radius><length>1.5</length></cylinder></geometry>
        </collision>
        <visual name="canopy_visual">
          <pose>0 0 1.8 0 0 0</pose>
          <geometry><sphere><radius>0.9</radius></sphere></geometry>
          <material><ambient>0.15 0.3 0.1 1</ambient><diffuse>0.2 0.4 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="tree_2">
      <static>true</static>
      <pose>-2.4 4.2 0 0 0 0.6</pose>
      <link name="link">
        <visual name="trunk_visual">
          <pose>0 0 0.6 0 0 0</pose>
          <geometry><cylinder><radius>0.1</radius><length>1.2</length></cylinder></geometry>
          <material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.35 0.22 0.12 1</diffuse></material>
        </visual>
        <collision name="trunk_collision">
          <pose>0 0 0.6 0 0 0</pose>
          <geometry><cylinder><radius>0.1</radius><length>1.2</length></cylinder></geometry>
        </collision>
        <visual name="canopy_visual">
          <pose>0 0 1.5 0 0 0</pose>
          <geometry><sphere><radius>0.7</radius></sphere></geometry>
          <material><ambient>0.15 0.3 0.1 1</ambient><diffuse>0.2 0.4 0.12 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>